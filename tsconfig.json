{
	"compilerOptions": {
		"target": "esnext",
		"module": "esnext",
		"moduleResolution": "bundler",
		"strict": true,
		"strictNullChecks": true,
		"skipLibCheck": true,
		"noFallthroughCasesInSwitch": true,
		"resolveJsonModule": true,
		"verbatimModuleSyntax": true,
		"allowSyntheticDefaultImports": true,
		"noEmit": true,
		"paths": {
			"~/*": ["./src/*"]
		}
	},
	"include": ["src"]
}
